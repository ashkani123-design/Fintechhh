# GEMINI_API_KEY: Required for Gemini AI API calls (voice transcription & speech refinement).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for proxy headers and redirects).
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT="3000"

# NODE_ENV: production or development
NODE_ENV="production"

# VITE_API_BASE_URL: Optional override for backend API base URL (default: /api)
# VITE_API_BASE_URL="/api"

